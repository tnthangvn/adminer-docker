# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# Generate a fresh secret with: openssl rand -hex 32
#
# EVERY key here is optional: docker-compose.yml carries a placeholder default
# for each, so the stack comes up on a bare clone with no `.env` at all. The
# defaults are deliberately obvious (`postgres`, `redis`, `admin`,
# `*-change-me`) — seeing one in a running environment means `.env` was not
# loaded, not that it is configured.
#
# Fill this in on anything that is not a throwaway laptop.

# --- rong-viet-postgres ---
# Defaults: rongviet_user / rongviet_db / postgres.
# All three apply ONLY while the data volume is empty. Against an existing
# volume, changing them produces "password authentication failed" — Postgres
# does not rename anything after init.
# Note 5550 is published on 0.0.0.0, so POSTGRES_PASSWORD is what stands between
# the network and a freshly-initialised database.
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=

# --- rong-viet-redis ---
# Default: redis. Interpolated in THREE places in docker-compose.yml (the
# server's --requirepass, its healthcheck, and redis-commander's REDIS_HOSTS);
# they read the same variable, so setting it here keeps all three in sync.
REDIS_PASSWORD=

# --- redis-commander (web UI) ---
# Basic-auth for the browser UI, default admin/admin. Must NOT reuse
# REDIS_PASSWORD — see the comment on HTTP_PASSWORD in docker-compose.yml.
# admin/admin is only survivable because the port is bound to 127.0.0.1.
REDIS_COMMANDER_USER=
REDIS_COMMANDER_PASSWORD=
# Host port, 127.0.0.1 only. Default 8082.
REDIS_COMMANDER_PORT=

# --- rongviet-centrifugo ---
# Both MUST match the backend's env. The defaults are placeholders and will not
# match, so leaving these empty breaks realtime push at RUNTIME, not at startup:
# Centrifugo boots, then rejects every token and publish.
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=
CENTRIFUGO_HTTP_API_KEY=

# --- host port for rong-viet-redis ---
# HOST side only. Container-to-container traffic always uses 6379 and ignores
# this. Default 6379, published on 0.0.0.0 — see the comment in
# docker-compose.yml before exposing this on an untrusted network.
REDIS_PORT=

# --- redis-commander connection string (optional, leave empty) ---
# Format: label:host:port:dbIndex:password — `host` and `port` are the CONTAINER
# side (rong-viet-redis:6379), not the host mapping.
# Empty is the right answer: docker-compose.yml then builds this from
# REDIS_PASSWORD, so the password stays in one variable. Filling it in pins a
# SECOND copy of the password that drifts silently — commander just shows an
# empty UI. Only set it to point at a different Redis, or to list several
# (comma-separated).
REDIS_HOSTS=

# --- adminer SSH (optional) ---
# The login page carries an SSH tunnel card by default — nothing
# below is needed to use it. Set ADMINER_SSH_UI=

# Where a mounted ~/.ssh is read from, container-side. Default /ssh. Mount it
# in docker-compose.yml (the line is there, commented) and the card's Bastion field
# takes a Host alias, with the user, port and key coming from your config.
# SECURITY: this puts every key in that directory behind the login page — mount
# a directory holding only the keys meant for this, not your whole ~/.ssh.
ADMINER_SSH_CONFIG_DIR=off to remove those fields and
# allow only the tunnels declared here.
ADMINER_SSH_UI=

# --- adminer SSH tunnels opened at startup (optional, empty = none) ---
# Databases reachable only through a bastion. One per line:
#   label=<local_port>:<db_host>:<db_port>:<ssh_user>@<ssh_host>[:<ssh_port>]
# `db_host` is resolved ON THE BASTION, so it may be a private name or address
# this machine cannot reach — that is the point. Adminer then connects to
# 127.0.0.1:<local_port>, which the login page offers by label.
# Per-tunnel options after a `|`:  key=<path>  pass=<NAME_OF_ENV_VAR>
# Empty = no ssh process starts at boot; the login form still works.
# See README, "Databases behind SSH".
ADMINER_SSH_TUNNELS=

# Default private key for those tunnels, as seen INSIDE the container — mount
# it there first (docker-compose.yml has the line, commented). Host file
# permissions do not matter; the key is copied to tmpfs at 0600 on startup.
ADMINER_SSH_KEY=

# known_hosts to pin the bastion's host key, container-side path. Leave empty
# and the first host key offered is trusted: fine against your own bastion on
# your own laptop, not against anything reached over a network you don't own.
ADMINER_SSH_KNOWN_HOSTS=

# Seconds a login-form tunnel may go unused before it is closed. Default 1800.
ADMINER_SSH_IDLE=

# Who the container runs as, applied at BUILD time (not `user:` — ssh refuses
# to start for a uid with no /etc/passwd entry). Set these to your own ids to
# let it read a mounted ~/.ssh, whose keys are 0600 and belong to you:
#   HOST_UID=$(id -u) HOST_GID=$(id -g) docker compose up -d --build
# Default 10001, a service account, which is right when no ~/.ssh is mounted.
HOST_UID=
HOST_GID=

# Where the tunnel card keeps saved tunnels, container-side. Default
# /data/tunnels.json, a named volume in docker-compose.yml. Holds bastions,
# hosts and ports — never a key or a password. Leave the volume out and the
# card still opens tunnels, it just stops offering to save them.
ADMINER_SSH_PROFILES=
